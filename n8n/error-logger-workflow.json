{
  "name": "TriageFlow - error logger",
  "nodes": [
    {
      "parameters": {},
      "id": "e601cd0c-f53e-5720-bf8b-3b569510b422",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into workflow_errors (workflow_name, node_name, error_message, execution_id, execution_url) values ($1, $2, $3, $4, $5);",
        "options": {
          "queryReplacement": "={{ [$json.workflow?.name, $json.execution?.lastNodeExecuted, ($json.execution?.error?.message ?? 'unknown').slice(0, 1000), String($json.execution?.id ?? ''), $json.execution?.url ?? null] }}"
        }
      },
      "id": "5fec0031-4b91-5ef2-b4e2-3fa207c92644",
      "name": "Log error to Supabase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        240,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "TfPostgres000001",
          "name": "Supabase Postgres"
        }
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Log error to Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false,
  "tags": []
}
