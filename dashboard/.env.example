# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: a throwaway demo login shown on the sign-in page for reviewers.
# Create it in Supabase -> Authentication -> Users -> Add user (tick Auto Confirm User).
VITE_DEMO_EMAIL=demo@triageflow.app
VITE_DEMO_PASSWORD=choose-a-demo-password

# Server-only (no VITE_ prefix): used by api/try-ticket.js, never sent to the browser.
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/support-ticket
N8N_WEBHOOK_SECRET=your-webhook-secret
